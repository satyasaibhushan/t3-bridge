{
  "name": "t3-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .test-build && node --test .test-build/test/*.test.js",
    "lint": "prettier --check src test *.json",
    "format": "prettier --write src test *.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
